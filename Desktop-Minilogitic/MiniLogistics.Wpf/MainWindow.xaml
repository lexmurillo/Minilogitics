
<Window x:Class="MiniLogistics.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniLogistics"
        Height="600"
        Width="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="LightGray">
            <TextBlock Text="MiniLogistics"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20"/>
        </Border>

        <!-- PESTAÑAS PRINCIPALES -->
        <TabControl Grid.Row="1"
                    Margin="5">

            <!-- PESTAÑA PAQUETES -->
            <TabItem Header="Paquetes">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
						
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TABLA DE PAQUETES -->
                        <Border Grid.Column="0"
                                Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
									<RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="PAQUETES"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="10"/>
								<StackPanel Grid.Row="1"
                                         Orientation="Horizontal"
                                         VerticalAlignment="Center"
                                         Margin="10,0">

									<TextBlock Text="Buscar por ID:"
											   VerticalAlignment="Center"
											   Margin="0,0,8,0"/>

									<TextBox x:Name="BuscarPaqueteIdTextBox"
											 Width="100"
											 Height="28"
											 VerticalContentAlignment="Center"
											 Margin="0,0,8,0"/>

									<Button Content="Buscar"
											Width="85"
											Height="28"
											Click="BuscarPaquete_Click"/>

								</StackPanel>

                                <DataGrid x:Name="PaquetesDataGrid"
                                          Grid.Row="2"
                                          Margin="10"
                                          AutoGenerateColumns="True"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"/>
                            </Grid>
                        </Border>

                        <!-- DETALLE DEL PAQUETE -->
                        <Border Grid.Column="1"
                                Background="Beige"
                                Margin="5"
                                Padding="15">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="DETALLE DEL PAQUETE"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,0,0,20"/>

                                    <TextBlock Text="ID:"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="IdTextBlock"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Descripción:"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="DescripcionTextBlock"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Peso:"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="PesoTextBlock"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Origen:"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="OrigenTextBlock"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Destino:"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="DestinoTextBlock"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Fecha de creación:"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="FechaTextBlock"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- BOTONES EXCLUSIVOS DE PAQUETES -->
                    <Border Grid.Row="1"
                            Background="LightGray"
                            Margin="5,0,5,5"
                            Padding="5">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Button Content="Nuevo paquete"
                                    Width="140"
                                    Height="35"
                                    Margin="5"
                                    Click="NuevoPaquete_Click"/>

                            <Button Content="Actualizar"
                                    Width="120"
                                    Height="35"
                                    Margin="5"
                                    Click="Actualizar_Click"/>

                            <Button Content="Eliminar"
                                    Width="120"
                                    Height="35"
                                    Margin="5"
                                    Click="Eliminar_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>


			<!-- PESTAÑA ENVÍOS -->
			<TabItem Header="Envíos">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="45"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="75"/>
					</Grid.RowDefinitions>

					<!-- ENCABEZADO -->
					<TextBlock Grid.Row="0"
							   Text="GESTIÓN DE ENVÍOS"
							   FontSize="22"
							   FontWeight="Bold"
							   VerticalAlignment="Center"
							   Margin="10,0"/>
					<Grid Grid.Row="0" Margin="10,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0"
								   Text="GESTIÓN DE ENVÍOS"
								   FontSize="22"
								   FontWeight="Bold"
								   VerticalAlignment="Center"/>

						<StackPanel Grid.Column="1"
									Orientation="Horizontal"
									VerticalAlignment="Center">

							<TextBlock Text="Buscar por ID:"
									   VerticalAlignment="Center"
									   Margin="5"/>

							<TextBox x:Name="BuscarEnvioIdTextBox"
									 Width="70"
									 Height="28"
									 VerticalContentAlignment="Center"
									 Margin="5"/>

							<Button Content="Buscar"
									Width="80"
									Height="28"
									Margin="5"
									Click="BuscarEnvio_Click"/>
						</StackPanel>
					</Grid>

					<!-- TABLA -->
					<DataGrid x:Name="EnviosDataGrid"
							  Grid.Row="1"
							  Margin="5"
							  AutoGenerateColumns="True"
							  CanUserAddRows="False"
							  IsReadOnly="True"
							  SelectionMode="Single"
							  SelectionUnit="FullRow"/>

					<!-- CONTROLES DE ENVÍOS -->
					<Border Grid.Row="2"
							Background="LightGray"
							Margin="5"
							Padding="5">

						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">

							<TextBlock Text="ID del paquete:"
									   VerticalAlignment="Center"
									   Margin="5"/>

							<TextBox x:Name="PackageIdTextBox"
									 Width="75"
									 Height="30"
									 VerticalContentAlignment="Center"
									 Margin="5"/>

							<Button Content="Crear envío"
									Width="105"
									Height="35"
									Margin="5"
									Click="CrearEnvio_Click"/>

							<TextBlock Text="Estado:"
									   VerticalAlignment="Center"
									   Margin="5"/>

							<ComboBox x:Name="EstadoEnvioComboBox"
									  Width="115"
									  Height="30"
									  VerticalContentAlignment="Center"
									  SelectedIndex="0"
									  Margin="5">
								<ComboBoxItem Content="Created"/>
								<ComboBoxItem Content="InTransit"/>
								<ComboBoxItem Content="Delivered"/>
							</ComboBox>

							<TextBlock Text="Ciudad:"
									   VerticalAlignment="Center"
									   Margin="5"/>

							<ComboBox x:Name="CiudadTrackingComboBox"
									  Width="145"
									  Height="30"
									  VerticalContentAlignment="Center"
									  SelectedIndex="0"
									  Margin="5">
								<ComboBoxItem Content="Bogotá"/>
								<ComboBoxItem Content="Medellín"/>
								<ComboBoxItem Content="Cali"/>
								<ComboBoxItem Content="Barranquilla"/>
								<ComboBoxItem Content="Bucaramanga"/>
								<ComboBoxItem Content="Monterrey"/>
								<ComboBoxItem Content="San Luis Potosí"/>
							</ComboBox>


							<Button Content="Cambiar estado"
									Width="125"
									Height="35"
									Margin="5"
									Click="CambiarEstadoEnvio_Click"/>

							<Button Content="Actualizar"
									Width="95"
									Height="35"
									Margin="5"
									Click="ActualizarEnvios_Click"/>

							<Button Content="Eliminar envío"
									Click="EliminarEnvio_Click"
									Margin="5"
									Padding="10,5"/>


						</StackPanel>
					</Border>
				</Grid>
			</TabItem>



			<!-- PESTAÑA TRACKING -->
			<TabItem Header="Tracking">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="45"/>
						<RowDefinition Height="45"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
							   Text="SEGUIMIENTO DE ENVÍOS"
							   FontSize="22"
							   FontWeight="Bold"
							   VerticalAlignment="Center"
							   Margin="10,0"/>

					<StackPanel Grid.Row="1"
								Orientation="Horizontal"
								VerticalAlignment="Center"
								Margin="10,0">

						<TextBlock Text="ID del paquete:"
								   VerticalAlignment="Center"
								   Margin="0,0,10,0"/>

						<TextBox x:Name="PackageIdTrackingTextBox"
								 Width="100"
								 Height="28"
								 VerticalContentAlignment="Center"
								 Margin="0,0,10,0"/>

						<Button Content="Consultar"
								Width="100"
								Height="28"
								Click="ConsultarTracking_Click"/>
					</StackPanel>

					<DataGrid x:Name="TrackingDataGrid"
							  Grid.Row="2"
							  Margin="10"
							  AutoGenerateColumns="True"
							  CanUserAddRows="False"
							  IsReadOnly="True"/>
				</Grid>
			</TabItem>



		</TabControl>
    </Grid>
</Window>

