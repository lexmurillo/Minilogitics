<Window x:Class="MiniLogistics.Wpf.NewPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo paquete"
        Height="430"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="REGISTRAR PAQUETE"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Descripción"/>
            <TextBox x:Name="DescripcionTextBox"
                     Margin="0,5,0,0"
                     Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Peso (kg)"/>
            <TextBox x:Name="PesoTextBox"
                     Margin="0,5,0,0"
                     Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Origen"/>
            <TextBox x:Name="OrigenTextBox"
                     Margin="0,5,0,0"
                     Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Destino"/>
            <TextBox x:Name="DestinoTextBox"
                     Margin="0,5,0,0"
                     Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="100"
                    Margin="5"
                    IsCancel="True"/>

            <Button Content="Guardar"
                    Width="100"
                    Margin="5"
                    IsDefault="True"
                    Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
